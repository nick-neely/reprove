{
  "name": "@reprove/control-plane-workflow",
  "version": "0.0.0",
  "description": "Every workflow and step definition for the hosted control plane, and all step configuration.",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@reprove/control-plane": "workspace:*",
    "@reprove/protocol": "workspace:*",
    "workflow": "catalog:workflow"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workflow/vitest": "catalog:workflow",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
