{
  "name": "@reprove/control-plane",
  "version": "0.0.0",
  "description": "Control-plane substance: GitHub ingress, scheduling, persistence, Acceptance, Reconciliation and publication. Reads no environment variables.",
  "license": "Apache-2.0",
  "bin": {
    "reprove-control-plane": "./dist/bin.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:force": "pnpm run build && node ./dist/db/force-generate.js"
  },
  "dependencies": {
    "@reprove/protocol": "workspace:*",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
