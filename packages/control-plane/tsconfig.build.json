{
  "extends": "./tsconfig.json",
  // The unshipped files, which `tools/verify-workspace.mjs` matches with one
  // pattern of its own: a test, and the support module a test imports. Both are
  // type-checked by `tsconfig.json` and neither is packed - a published package
  // ships no test, and no module that knows the address of a local Docker stack.
  "exclude": ["src/**/*.test.ts", "src/**/*.test-support.ts"]
}
